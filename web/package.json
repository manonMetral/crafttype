{
  "name": "crafttype-web",
  "private": true,
  "type": "module",
  "description": "Page of the local interface of CraftType (crafttype ui)",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
