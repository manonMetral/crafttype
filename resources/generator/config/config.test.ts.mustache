import { describe, expect, it } from 'vitest';
import { loadConfig } from './config.js';

describe('loadConfig', () => {
  it('prend le port {{serverPort}} et l’adresse locale par défaut', () => {
    expect(loadConfig({})).toEqual({ port: {{serverPort}}, host: '127.0.0.1' });
  });

  it('lit PORT et HOST', () => {
    expect(loadConfig({ PORT: '8080', HOST: '0.0.0.0' })).toEqual({
      port: 8080,
      host: '0.0.0.0',
    });
  });

  it('ignore les valeurs vides', () => {
    expect(loadConfig({ PORT: ' ', HOST: '' })).toEqual({
      port: {{serverPort}},
      host: '127.0.0.1',
    });
  });

  it.each(['abc', '0', '-1', '3.5', '65536'])('refuse PORT=%s', (port) => {
    expect(() => loadConfig({ PORT: port })).toThrow('PORT invalide');
  });
});
