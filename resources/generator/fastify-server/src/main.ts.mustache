import { buildApp } from './app.js';
// crafttype-needle-main-imports

const settings = {
  port: {{serverPort}},
  host: '127.0.0.1',
};

try {
  // crafttype-needle-main-settings
  const app = buildApp();
  await app.listen(settings);
} catch (error) {
  console.error(error instanceof Error ? error.message : error);
  process.exit(1);
}
