import Fastify, {
  type FastifyInstance,
  type FastifyServerOptions,
} from 'fastify';
// crafttype-needle-app-imports

export function buildApp(options: { logger?: boolean } = {}): FastifyInstance {
  const serverOptions: FastifyServerOptions = {
    logger: options.logger ?? true,
  };
  // crafttype-needle-app-server-options
  const app = Fastify(serverOptions);
  // crafttype-needle-app-plugins

  // The routes live in a plugin registered after the ones above: a route declared directly on `app` is added before
  // those plugins are loaded, and plugins that watch the routes (OpenAPI for instance) would never see it.
  app.register(async (routes) => {
    routes.get(
      '/api/health',
      {
        schema: {
          response: {
            200: {
              type: 'object',
              properties: { status: { type: 'string', enum: ['UP'] } },
              required: ['status'],
            },
          },
        },
      },
      async () => ({ status: 'UP' }),
    );
  });

  return app;
}
