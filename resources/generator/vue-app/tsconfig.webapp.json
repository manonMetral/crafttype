{
  // Front-end typing: tsc checks the .ts files of src/webapp (main.ts, router.ts...). The <script> of .vue files
  // is not checked: vue-tsc does not support TypeScript 7 yet. Replace with `vue-tsc --noEmit` once it does.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": ["src/webapp"],
  "exclude": []
}
