{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "@types/node stays on the major version of the minimum supported Node (engines >=22.12), so typing rejects APIs missing from Node 22",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<23"
    },
    {
      "description": "Version catalog injected into generated projects: a single group, validated by the generation CI",
      "matchFileNames": ["resources/generator/dependencies/**/package.json"],
      "groupName": "version catalog for generated projects",
      "rangeStrategy": "pin",
      "semanticCommitType": "feat",
      "semanticCommitScope": "catalog"
    },
    {
      "description": "CraftType's own tooling",
      "matchFileNames": ["package.json"],
      "groupName": "development tooling",
      "matchUpdateTypes": ["minor", "patch"]
    }
  ]
}
